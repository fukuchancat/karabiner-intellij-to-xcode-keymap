{
    "title": "Xcode",
    "rules": [
        {
            "description": "Map a double-tap of the left shift key in IntelliJ to Xcode's 'Command + Shift + O' for Open Quickly.",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "name": "left_shift_key",
                            "type": "variable_if",
                            "value": 1
                        },
                        {
                            "bundle_identifiers": [
                                "^com\\.apple\\.dt.Xcode$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "left_shift"
                    },
                    "to": [
                        {
                            "key_code": "o",
                            "modifiers": [
                                "command",
                                "shift"
                            ]
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "name": "left_shift_key",
                            "type": "variable_if",
                            "value": 0
                        },
                        {
                            "bundle_identifiers": [
                                "^com\\.apple\\.dt.Xcode$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "left_shift",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "left_shift_key",
                                "value": 1
                            }
                        },
                        {
                            "key_code": "left_shift"
                        }
                    ],
                    "to_delayed_action": {
                        "to_if_canceled": [
                            {
                                "set_variable": {
                                    "name": "left_shift_key",
                                    "value": 0
                                }
                            }
                        ],
                        "to_if_invoked": [
                            {
                                "set_variable": {
                                    "name": "left_shift_key",
                                    "value": 0
                                }
                            }
                        ]
                    },
                    "type": "basic"
                }
            ]
        },
